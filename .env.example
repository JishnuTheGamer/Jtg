# Server Configuration
# Main Panel Production Port
PORT=6767

# Whether to enable Docker support (true/false)
ENABLE_DOCKER=false

# Development Port (Disabled by default. Uncomment to use dev port 3000)
# PORT=3000
# VITE_ENABLE_DEV_MODE=true

JWT_SECRET="your-secure-random-jwt-secret-here"

# Gemini AI API Key (Optional, kept server-side)
GEMINI_API_KEY="your-gemini-api-key"

DOCKER_SOCKET_PATH=
VITE_ENABLE_DEVELOPER_PANEL=true

# CORS & Allowed Origins Configuration
# Comma-separated list of allowed origins or hostnames for production domain enforcement.
# Note: CodeSandbox (*.csb.app, *.codesandbox.io), Cloud Run (*.run.app), and localhost loopback
# are trusted by default for preview/development workflows. Production deployments should define
# ALLOWED_ORIGINS with their custom production domains (e.g. https://panel.example.com).
ALLOWED_ORIGINS=

# Frontend base path (default: /)
VITE_BASE_PATH=/

# Optional root directory override for container deployments
JTG_ROOT_DIR=
